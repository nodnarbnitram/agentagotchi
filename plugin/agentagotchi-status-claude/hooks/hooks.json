{
  "description": "Privacy-filtered lifecycle status for the local Agentagotchi bridge.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
